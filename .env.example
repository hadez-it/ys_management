# YS SVC — ပတ်ဝန်းကျင် ပြင်ဆင်ချက်များ (Environment Configuration)
# လျှို့ဝှက်ကီးများကို အောက်ပါ command ဖြင့် ထုတ်ယူနိုင်သည် (Generate strong secrets with):
#   openssl rand -base64 48

# MongoDB Atlas ချိတ်ဆက်မှု လိပ်စာ (Required: MongoDB Atlas connection string)
MONGO_URI=CHANGE_ME

# JWT လက်မှတ်ထိုးရန် လျှို့ဝှက်ကီး — အနည်းဆုံး ၃၂ လုံး ရှိရမည် (Required: min 32 characters; generate with `openssl rand -base64 48`)
JWT_SECRET=CHANGE_ME

# ကနဦး အသုံးပြုသူ စကားဝှက်များ — အနည်းဆုံး ၁၂ လုံး စီရှိရမည်၊ မထည့်သွင်းပါက ၎င်းအကောင့်ကို ကျော်သွားမည်
# (Optional seed user passwords: min 12 characters each; unset accounts are skipped during seeding)
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_COORDINATOR_PASSWORD=CHANGE_ME
INITIAL_SENIOR_TECH_PASSWORD=CHANGE_ME
INITIAL_TECHNICIAN_PASSWORD=CHANGE_ME

# AI လက်မှတ် အလိုအလျောက်ဖြည့်သွင်းခြင်းအတွက် Gemini API Key (Optional: for /api/parse-ticket)
GEMINI_API_KEY=CHANGE_ME

# Production Application Origin URL (Optional: for exact-match CORS allow-list)
APP_URL=CHANGE_ME